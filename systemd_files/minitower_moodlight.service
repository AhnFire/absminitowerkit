[Unit]
Description=Minitower fan light / mood light (WS281X, minitower-leds)
After=multi-user.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/minitower-leds --config /etc/minitower/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
# The WS281X driver maps the DMA/PWM registers through /dev/vcio, so it needs
# root. It blanks the strip on the way out, which the old C binary did not - that
# is why the LEDs used to stay latched on the last frame after a stop.
User=root

[Install]
WantedBy=multi-user.target

# Differences vs the original systemd_files/minitower_moodlight.service:
#   - ExecStart runs minitower-leds instead of the vendor's compiled `moodlight`
#     binary, which was upstream's 8x8 matrix demo (64 pixels) driven at 15 fps
#     against a 4-6 LED strip, with no geometry arguments at all
#   - Restart=on-failure rather than always, so a clean exit stays stopped
#   - TimeoutStopSec, so a stuck shutdown cannot hang the unit
